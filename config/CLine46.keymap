/* SOA44 V2 -> CLine46 ZMK keymap port (draft; CI build required).
 * Based on SOA44 V2 source: ryo-nagaoka/zmk-config-soa44-v2, main.
 * CLine46 hardware, battery, pointing, and RGB configurations must remain
 * from takamaru-fpv/zmk_config_CLine46, branch zmk4.1対応.
 *
 * Original 44 positions: 0..35 (3 rows x12), 36..43 (thumb row x8).
 * New 46 positions:      0..35 (unchanged), 36..45 (thumb row x10).
 * Mapping of old bottom row into new bottom row:
 * old 36,37,38,39,40,41,42,43 -> new 36,37,39,40,41,42,43,45
 * New 38 = ESC on base, new 44 = DEL on base / studio_unlock on SCROLL.
 */

#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/runtime_macro.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <32 33>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        to_eisu: to_eisu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "TO_EISU";
            bindings = <&kp LC(SPACE)>;
        };

        to_kana: to_kana {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "TO_KANA";
            bindings = <&kp LANG1>;
        };
    };

    behaviors {
        scroll_hold: scroll_hold {
            compatible = "zmk,behavior-hold-tap";
            label = "SCROLL_HOLD";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };

        rmclk: layer_mouse_right_click {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_MOUSE_RIGHT_CLICK";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&mkp>;
        };

        zenhan_td: zenhan_tap_dance {
            compatible = "zmk,behavior-tap-dance";
            label = "ZENHAN_TAP_DANCE";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&kp LANG1>, <&kp LANG2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            bindings = <
&kp LC(SPACE)   &mo 4         &kp W         &kp E    &kp R     &kp T                                      &kp Y        &kp U  &kp I  &kp O      &kp MINUS  &kp BACKSPACE
&kp LEFT_SHIFT  &kp A         &kp S         &kp D    &kp F     &kp G                                      &kp H        &kp J  &kp K  &kp L      &kp P      &kp ENTER
&kp LCTRL       &kp Z         &kp X         &kp C    &kp V     &kp B                                      &kp B        &kp N  &kp M  &kp COMMA  &kp DOT    &kp RIGHT_SHIFT
                &kp LEFT_WIN  &kp LEFT_ALT  &kp ESC  &mkp MB1  &rmclk 1 MB2  &lt 3 QUESTION    &lt 2 TAB  &lt 5 SPACE                &kp DEL    &kp RCTRL
            >;
        };

        MOUSE {
            bindings = <
&kp ESCAPE     &kp Q      &trans     &kp UP          &mkp MB4         &mkp MB5                                    &kp EXCLAMATION       &kp SEMICOLON          &kp UNDERSCORE    &kp HASH           &kp TILDE      &kp DEL
&kp LS(LA(F))  &kp PRCNT  &kp LC(A)  &kp LC(V)       &kp LC(C)        &kp SINGLE_QUOTE                            &kp COLON             &kp AMPERSAND          &kp ASTERISK      &kp AT_SIGN        &kp INT_YEN    &kp LC(ENTER)
&kp LCTRL      &kp LC(Z)  &trans     &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp DOUBLE_QUOTES                           &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LESS_THAN  &kp GREATER_THAN
               &trans     &trans     &trans          &trans           &trans             &trans    &kp PAGE_DOWN  &kp PAGE_UP                                                    &trans             &kp LG(LC(V))
            >;
        };

        FUNCTION {
            bindings = <
&trans  &trans  &trans  &trans   &trans   &trans                     &trans  &trans  &trans  &trans  &trans  &trans
&kp F1  &kp F2  &kp F3  &kp F4   &kp F5   &kp F6                     &trans  &trans  &trans  &trans  &trans  &trans
&kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12                    &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans   &trans   &trans   &trans    &trans  &trans                  &trans  &trans
            >;
        };

        NUM {
            bindings = <
&trans  &trans            &trans             &trans          &trans           &trans                           &kp PRCNT      &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp EQUAL  &kp BACKSPACE
&trans  &trans            &trans             &trans          &mkp MB4         &mkp MB5                         &kp TILDE      &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp SLASH  &kp ENTER
&trans  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp PIPE                         &kp NUMBER_0   &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp MINUS  &kp PLUS
        &trans            &trans             &trans          &trans           &trans    &trans    &kp LC(ESC)  &kp AMPERSAND                              &kp ASTRK     &kp DOT
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans          &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans          &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans          &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                  &studio_unlock  &trans
            >;
        };

        ARROW {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                  &trans  &trans
            >;
        };

        Bluetooth {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans        &trans        &trans        &trans        &trans          &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &bootloader   &trans        &trans        &trans        &trans          &bt BT_CLR
        &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                                    &trans        &bt BT_CLR_ALL
            >;
        };
    };
};
